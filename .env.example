# Copy this file to .env for local development. The .env file is ignored.
# Keep authentication in the Snowflake CLI connection stored outside this
# repository; never add passwords, TOTP codes, private keys, or account IDs.

# Name of the local connection shown by: snow connection list
SNOWFLAKE_CONNECTION_NAME=your-local-connection-name

# dbt uses the same account and user but authenticates independently. External
# browser authentication keeps passwords and keys out of this repository.
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-user-name
SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Non-secret demo object names
SNOWFLAKE_DATABASE=SCHOOL_WELLBEING_DEMO
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_LOAD_WAREHOUSE=WELLBEING_DEMO_LOAD_WH
SNOWFLAKE_TRANSFORM_WAREHOUSE=WELLBEING_DEMO_TRANSFORM_WH
SNOWFLAKE_APP_WAREHOUSE=WELLBEING_DEMO_APP_WH

# Example monthly demo quota passed to 04_cost_monitor.sql.
# Review this value for your account before applying it.
WELLBEING_CREDIT_QUOTA=20
