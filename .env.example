# Copy this file to .env for local development. The .env file is ignored.
# Keep authentication in the Snowflake CLI connection stored outside this
# repository; never add passwords, TOTP codes, private keys, or account IDs.

# Name of the local connection shown by: snow connection list
SNOWFLAKE_CONNECTION_NAME=your-local-connection-name

# dbt uses the same account and user but authenticates independently. External
# browser authentication keeps passwords and keys out of this repository.
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-user-name
SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Optional PAT authentication for non-interactive dbt runs. Keep the token
# itself outside this repository. scripts/dbt-build.sh also accepts the
# dashboard PAT settings below, so this personal demo needs only one PAT.
# SNOWFLAKE_PAT_FILE=/absolute/path/to/wellbeing-transformer.pat

# Non-secret demo object names
SNOWFLAKE_DATABASE=SCHOOL_WELLBEING_DEMO
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_LOAD_WAREHOUSE=WELLBEING_DEMO_LOAD_WH
SNOWFLAKE_TRANSFORM_WAREHOUSE=WELLBEING_DEMO_TRANSFORM_WH
SNOWFLAKE_APP_WAREHOUSE=WELLBEING_DEMO_APP_WH

# Example monthly demo quota passed to 04_cost_monitor.sql.
# Review this value for your account before applying it.
WELLBEING_CREDIT_QUOTA=20

# Milestone 3 dashboard runtime. These values are read only by the Next.js
# server. Never rename them with NEXT_PUBLIC_, which would expose them to the
# browser bundle. This personal demo can reuse the SSES79 PAT while the server
# forces one tenant reader role. Use a dedicated service identity for hosting.
DASHBOARD_TENANT=trust_north
SNOWFLAKE_DASHBOARD_USER=your-dashboard-service-user
SNOWFLAKE_DASHBOARD_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN
# Store the token outside the repository and use an absolute path.
SNOWFLAKE_DASHBOARD_PAT_FILE=/absolute/path/to/wellbeing-dashboard.pat
# Recommended alternative for hosted environments:
# SNOWFLAKE_DASHBOARD_AUTHENTICATOR=SNOWFLAKE_JWT
# SNOWFLAKE_DASHBOARD_PRIVATE_KEY_PATH=/run/secrets/wellbeing-dashboard.p8
# SNOWFLAKE_DASHBOARD_PRIVATE_KEY_PASSPHRASE=load-from-your-secret-manager
